# =============================================================================
# FanCue — Environment Configuration Template
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - .env is in .gitignore and must NEVER be committed to version control.
# - Replace all placeholder values with your actual local configuration.
# - Never put real API keys or passwords in this file.
# - This file (.env.example) contains only safe placeholder values and IS
#   committed to version control as the canonical configuration reference.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
FANCUE_ENV=development
# Options: development | staging | production
LOG_LEVEL=DEBUG
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_STRING_MIN_32_CHARS

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
# In production, set to your deployed backend URL:
# VITE_API_BASE_URL=https://api.fancue.example.com
# This variable is baked into the frontend static build. Never put secrets here.

# ---------------------------------------------------------------------------
# PostgreSQL (planned — Phase 07)
# ---------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=fancue
POSTGRES_USER=fancue_user
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DEV_PASSWORD
DATABASE_URL=postgresql://fancue_user:REPLACE_WITH_LOCAL_DEV_PASSWORD@127.0.0.1:5432/fancue

# ---------------------------------------------------------------------------
# Qdrant (semantic knowledge retrieval)
# ---------------------------------------------------------------------------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
# Leave QDRANT_API_KEY empty for local development (no auth on local Docker).
# Required for managed Qdrant Cloud deployments.
QDRANT_COLLECTION_DEV=fancue_cricket_knowledge_dev_v1
QDRANT_COLLECTION_PROD=fancue_cricket_knowledge_v1
QDRANT_COLLECTION_VECTOR_SIZE=384
# Must match the embedding model output dimensions.

# ---------------------------------------------------------------------------
# Embedding provider (Phase 04 default: local CPU fastembed)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=fastembed
# Options: fastembed | openai | sentence_transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Must be consistent with QDRANT_COLLECTION_VECTOR_SIZE.
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY

# ---------------------------------------------------------------------------
# Language model provider
# ---------------------------------------------------------------------------
# Provider selection: groq (default) | openai
LLM_PROVIDER=groq

# Groq Configuration (Fast, free-tier accessible OpenAI-compatible inference)
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30

# OpenAI Configuration (Switch by setting LLM_PROVIDER=openai)
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
OPENAI_ORG_ID=
# Optional. Leave empty if not using an organization account.

# ---------------------------------------------------------------------------
# Cricket Data API (cricketdata.org — near-live match discovery)
# ---------------------------------------------------------------------------
CRICKET_DATA_API_KEY=REPLACE_WITH_YOUR_CRICKET_DATA_API_KEY
CRICKET_DATA_API_URL=https://api.cricapi.com/v1/
CRICKET_DATA_TIMEOUT_SECONDS=10.0
CRICKET_DATA_CACHE_TTL_SECONDS=300


# ---------------------------------------------------------------------------
# Request limits and timeouts
# ---------------------------------------------------------------------------
MAX_INTERVAL_OVERS=50
# Maximum number of overs an interval query may span (cricket).
MAX_INTERVAL_MINUTES=120
# Maximum match minutes an interval query may span (football).
REQUEST_TIMEOUT_SECONDS=60
RETRIEVAL_TOP_K=10
# Number of Qdrant results to retrieve per query.

# ---------------------------------------------------------------------------
# Feature flags (development only)
# ---------------------------------------------------------------------------
ENABLE_DETERMINISTIC_FALLBACK=true
ENABLE_VERIFICATION_STEP=true
SKIP_LLM_IN_TESTS=true
# When true, tests bypass the LLM call and use deterministic output only.
