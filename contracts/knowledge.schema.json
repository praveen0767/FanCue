          "enum": [
            "draft",
            "approved",
            "rejected"
          ],
          "title": "ReviewStatus",
          "type": "string"
        },
        "SourceCheckStatus": {
          "description": "Verification status of upstream references and citations.",
          "enum": [
            "verified",
            "unverified",
            "pending"
          ],
          "title": "SourceCheckStatus",
          "type": "string"
        },
        "SportType": {
          "description": "Supported sport domain identifiers.",
          "enum": [
            "cricket",
            "football"
          ],
          "title": "SportType",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "In-memory representation of an individual knowledge chunk with point ID.",
      "properties": {
        "chunk_id": {
          "description": "Deterministic chunk identifier: {doc_id}_c{chunk_index}_{chunk_sha256[:8]}.",
          "minLength": 8,
          "title": "Chunk Id",
          "type": "string"
        },
        "point_id": {
          "description": "Deterministic UUIDv5 suitable for Qdrant point identifier.",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "title": "Point Id",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/KnowledgeChunkPayload"
        },
        "token_count": {
          "description": "Token count under the target embedding tokenizer.",
          "minimum": 1,
          "title": "Token Count",
          "type": "integer"
        }
      },
      "required": [
        "chunk_id",
        "point_id",
        "payload",
        "token_count"
      ],
      "title": "KnowledgeChunk",
      "type": "object"
    }
  }
}
