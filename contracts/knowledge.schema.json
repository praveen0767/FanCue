              "type": "integer"
            },
            "source_type": {
              "$ref": "#/$defs/KnowledgeSourceType"
            },
            "knowledge_type": {
              "$ref": "#/$defs/KnowledgeType"
            },
            "section_title": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Section Title",
              "type": "string"
            },
            "citation_locator": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Citation Locator"
            },
            "effective_from": {
              "anyOf": [
                {
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Effective From"
            },
            "effective_to": {
              "anyOf": [
                {
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Effective To"
            },
            "review_status": {
              "$ref": "#/$defs/ReviewStatus"
            },
            "source_check_status": {
              "$ref": "#/$defs/SourceCheckStatus"
            },
            "active": {
              "default": true,
              "title": "Active",
              "type": "boolean"
            },
            "text": {
              "description": "Exact normalized text passage.",
              "minLength": 10,
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "doc_id",
            "source_name",
            "source_url",
            "license",
            "language",
            "sport",
            "topic",
            "chunk_index",
            "ingestion_date",
            "permitted_use",
            "logical_doc_id",
            "document_revision",
            "source_revision",
            "content_sha256",
            "chunk_sha256",
            "chunker_version",
            "embedding_model",
            "embedding_model_revision",
            "source_type",
            "knowledge_type",
            "section_title",
            "review_status",
            "source_check_status",
            "text"
          ],
          "title": "KnowledgeChunkPayload",
          "type": "object"
        },
        "KnowledgeSourceType": {
          "description": "Origin classification of the content.",
          "enum": [
            "fancue_authored",
            "official_reference",
            "data_specification"
          ],
          "title": "KnowledgeSourceType",
          "type": "string"
        },
        "KnowledgeType": {
          "description": "Semantic category of knowledge note.",
          "enum": [
            "terminology",
            "interval_interpretation",
            "format_context",
            "rules"
          ],
          "title": "KnowledgeType",
          "type": "string"
        },
        "LanguageCode": {
          "description": "Supported output languages.\n\nEnglish ('en') is the normative baseline.\nTamil ('ta') is evaluated under AC-10 quality gates.",
          "enum": [
            "en",
            "ta"
          ],
          "title": "LanguageCode",
          "type": "string"
        },
